@using MyArt.Models;
@model Artist

<div class="container-fluid py-4">
    
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #84b133, #dfe057, #515c6a);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-lg me-2"></i>Create Artist</h5>
            <p class="mb-0 small" style="color: #FFF;">Add a new artist</p>
        </div>
        <div class="card-body p-4">
            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Artist First Name</label>
                    <input type="text" name="FirstName" asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                    <span class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Artist Last Name</label>
                    <input type="text" name="LastName" asp-for="LastName" class="form-control" placeholder="Enter last name" />
                    <span class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Place of Birth</label>
                    <input type="text" name="PlaceOfBirth" asp-for="PlaceOfBirth" class="form-control" placeholder="Enter place of birth" />
                    <span class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Year of Birth</label>
                    <input type="number" name="YearOfBirth" asp-for="YearOfBirth" class="form-control" placeholder="Enter year of birth" />
                    <span class="text-danger small"></span>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-outline-success fw-semibold">Create Artist</button>
                    <a asp-controller="Artist" asp-action="Index" class="btn btn-outline-secondary fw-medium">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

