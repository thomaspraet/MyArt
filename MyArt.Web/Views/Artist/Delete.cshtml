@using MyArt.Models;
@model Artist

<div class="container-fluid py-4">

    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #84b133, #dfe057, #515c6a);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-lg me-2"></i>Delete Artist</h5>
            <p class="mb-0 small" style="color: #FFF;">Delete artist information</p>
        </div>
        <div class="card-body p-4">
            <form method="post" asp-action="Delete">
                <input asp-for="Id" type="hidden" />
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Artist First Name</label>
                    <input type="text" name="FirstName" readonly asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                    
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Artist Last Name</label>
                    <input type="text" name="LastName" readonly asp-for="LastName" class="form-control" placeholder="Enter last name" />
                    
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Place of Birth</label>
                    <input type="text" name="PlaceOfBirth" readonly asp-for="PlaceOfBirth" class="form-control" placeholder="Enter place of birth" />
                    
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Year of Birth</label>
                    <input type="number" name="YearOfBirth" readonly asp-for="YearOfBirth" class="form-control" placeholder="Enter year of birth" />
                    
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-outline-danger fw-semibold">Delete Artist</button>
                    <a asp-controller="Artist" asp-action="Index" class="btn btn-outline-secondary fw-medium">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

