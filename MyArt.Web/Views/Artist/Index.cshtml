@using MyArt.Web.Models;
@model List<Artist>

<div class="container-fluid py-4">
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4 d-flex align-items-center justify-content-between" style="background: linear-gradient(to right, #84b133, #dfe057, #515c6a);">
            <div>
                <h5 class="mb-0 fw-bold"><i class="bi bi-grid me-2"></i>Categories</h5>
                <p class="mb-0 small" style="color: #FFF;">Manage your product categories</p>
            </div>
            <a asp-controller="Artist" asp-action="Create" class="btn btn-sm btn-outline-light fw-semibold d-inline-flex align-items-center gap-1">
                <i class="bi bi-plus-lg"></i> New Artist
            </a>
        </div>
        <div class="table-responsive">
            <table class="table-styled p-5">
                <thead>
                    <tr>
                        <th>Artist First Name</th>
                        <th>Artist Last Name</th>
                        <th>Place of Birth</th>
                        <th>Year of Birth</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="p-5">
                    @foreach (var artist in Model.OrderBy(a => a.LastName))
                    {
                        <tr>
                            <td class="fw-medium">@artist.FirstName</td>
                            <td class="fw-medium">@artist.LastName</td>
                            <td>@artist.PlaceOfBirth</td>
                            <td>@artist.YearOfBirth</td>
                            <td class="text-end">
                                <a asp-controller="Artist" asp-action="Update" asp-route-id="@artist.Id" class="btn btn-outline-success me-2">Edit</a>
                                <a asp-controller="Artist" asp-action="Delete" asp-route-id="@artist.Id" class="btn btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
